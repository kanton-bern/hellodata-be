{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePresets": [
    "group:springBoot",
    "group:springCloud",
    "group:springWs",
    "group:kotlinMonorepo",
    "group:typescriptEslintMonorepo"
  ],
  "timezone": "Europe/Zurich",
  "ignorePaths": [
    "**/requirements*.txt"
  ],
  "enabledManagers": [
    "maven",
    "npm",
    "dockerfile"
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ]
  },
  "prHourlyLimit": 0,
  "prConcurrentLimit": 10,
  "packageRules": [
    {
      "description": "Security updates: auto-create PRs immediately, bypass approval and grouping",
      "matchCategories": [
        "security"
      ],
      "dependencyDashboardApproval": false,
      "automerge": false,
      "groupName": null,
      "prPriority": 10,
      "schedule": [
        "at any time"
      ],
      "platformAutomerge": false
    },
    {
      "description": "Ignore internal Maven packages that Renovate cannot resolve",
      "matchManagers": [
        "maven"
      ],
      "matchPackageNames": [
        "/^ch\\.bedag\\.dap\\.hellodata:/"
      ],
      "enabled": false
    },
    {
      "description": "Hold keycloak-admin-client at 26.0.9: 26.0.10-26.0.12 break default-admin creation (400 on users.create) against the Keycloak 26.4 server, and no 26.1+ admin-client release exists to realign the client",
      "matchManagers": [
        "maven"
      ],
      "matchPackageNames": [
        "org.keycloak:keycloak-admin-client"
      ],
      "allowedVersions": "<=26.0.9"
    },
    {
      "description": "Pin spring-boot to 4.1.x (supported by Spring Cloud 2025.1.2+); raise once a Spring Cloud train targets Boot 4.2.x",
      "matchManagers": [
        "maven"
      ],
      "matchPackageNames": [
        "org.springframework.boot:spring-boot-dependencies"
      ],
      "allowedVersions": "<4.2.0"
    },
    {
      "description": "Keep spring-cloud on Oakwood (2025.1.x), which supports Spring Boot 4.0.x-4.1.x; raise once moving to the next train",
      "matchManagers": [
        "maven"
      ],
      "matchPackageNames": [
        "org.springframework.cloud:spring-cloud-dependencies"
      ],
      "allowedVersions": "<2025.2.0"
    },
    {
      "description": "Group all Spring packages (minor/patch)",
      "matchManagers": [
        "maven"
      ],
      "matchPackageNames": [
        "/^org\\.springframework/"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Spring packages (minor/patch)",
      "groupSlug": "spring-minor-patch"
    },
    {
      "description": "Group all Angular packages (minor/patch)",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "/^@angular\\//",
        "/^@angular-/",
        "/^angular-auth-oidc-client/",
        "/^primeng/",
        "/^@ngrx\\//",
        "/^@schematics\\//",
        "/^ng-packagr/",
        "/^zone\\.js/",
        "/^rxjs/",
        "/^tslib/"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Angular packages (minor/patch)",
      "groupSlug": "angular-minor-patch"
    },
    {
      "description": "Group remaining Java/Maven packages (minor/patch)",
      "matchManagers": [
        "maven"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Java packages (minor/patch)",
      "groupSlug": "java-minor-patch",
      "matchPackageNames": [
        "!/^org\\.springframework/",
        "!/^ch\\.bedag\\.dap\\.hellodata:/"
      ]
    },
    {
      "description": "Group remaining npm/yarn packages (minor/patch)",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "npm packages (minor/patch)",
      "groupSlug": "npm-minor-patch",
      "matchPackageNames": [
        "!/^@angular\\//",
        "!/^@angular-/",
        "!/^angular-auth-oidc-client/",
        "!/^primeng/",
        "!/^@ngrx\\//",
        "!/^@schematics\\//",
        "!/^ng-packagr/",
        "!/^zone\\.js/",
        "!/^rxjs/",
        "!/^tslib/"
      ]
    },
    {
      "description": "Group all Angular major updates",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "/^@angular\\//",
        "/^@angular-/",
        "/^angular-auth-oidc-client/",
        "/^@ngrx\\//",
        "/^primeng/",
        "/^@schematics\\//",
        "/^ng-packagr/",
        "/^zone\\.js/",
        "/^rxjs/",
        "/^tslib/"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "groupName": "Angular packages",
      "groupSlug": "angular-major"
    },
    {
      "description": "Group all Spring major updates",
      "matchManagers": [
        "maven"
      ],
      "matchPackageNames": [
        "/^org\\.springframework/"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "groupName": "Spring packages",
      "groupSlug": "spring-major"
    },
    {
      "description": "Each remaining major update gets its own PR",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "groupName": "major update: {{depName}}",
      "groupSlug": "major-{{depName}}",
      "matchPackageNames": [
        "!/^@angular\\//",
        "!/^@angular-/",
        "!/^angular-auth-oidc-client/",
        "!/^@ngrx\\//",
        "!/^@schematics\\//",
        "!/^ng-packagr/",
        "!/^zone\\.js/",
        "!/^rxjs/",
        "!/^tslib/",
        "!/^org\\.springframework/",
        "!/^ch\\.bedag\\.dap\\.hellodata:/",
        "!/^@fortawesome\\//",
        "!/^primeng/"
      ]
    },
    {
      "description": "Dockerfile base images: internal bedag images use build-arg tags and are released together with this repo",
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "/^bedag\\//"
      ],
      "enabled": false
    },
    {
      "description": "Temurin base image: stay on JDK 21 and understand the 21.0.13.1_2-jre tag format (build and revision parts)",
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "eclipse-temurin"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(\\.(?<build>\\d+))?_(?<revision>\\d+)-(?<compatibility>.+)$",
      "allowedVersions": "<22",
      "groupName": "Temurin base image",
      "groupSlug": "temurin-base-image",
      "schedule": [
        "at any time"
      ],
      "prPriority": 9
    },
    {
      "description": "Platform base images (Airflow, JupyterHub, Postgres) are deliberate upgrades: create PRs only after approval on the dependency dashboard",
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "apache/airflow",
        "/^quay\\.io\\/jupyter/",
        "postgres"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Red Hat UBI images: understand the 9.9-1795197514 tag format (minor and build number), so new builds are picked up",
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "/^registry\\.access\\.redhat\\.com\\/ubi/"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)-(?<patch>\\d+)$"
    },
    {
      "description": "Jupyter docker-stacks images: track the daily date tags (2026-11-23)",
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "quay.io/jupyter/base-notebook"
      ],
      "versioning": "regex:^(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})$"
    },
    {
      "description": "Airflow slim images: understand the slim-3.2.2-python3.12 tag format and keep the Python version",
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "apache/airflow"
      ],
      "versioning": "regex:^slim-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<compatibility>python\\d+\\.\\d+)$"
    }
  ]
}
