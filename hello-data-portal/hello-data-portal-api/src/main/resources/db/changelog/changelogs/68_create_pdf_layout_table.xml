<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <property name="uuid_type" value="uuid" dbms="postgresql"/>
    <property name="uuid_function" value="uuid_generate_v4()" dbms="postgresql"/>

    <changeSet id="68-1" author="slawomir.wieczorek">
        <comment>Create pdf_layout table for custom PDF layouts saved from the layout builder</comment>
        <createTable tableName="pdf_layout">
            <column name="id" type="${uuid_type}" defaultValueComputed="${uuid_function}">
                <constraints nullable="false" unique="true" primaryKey="true"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="${uuid_type}">
                <constraints nullable="false"/>
            </column>
            <column name="context_key" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="instance_name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="dashboard_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="dashboard_title" type="varchar(500)"/>
            <column name="template" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="page_count" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="grid_cols" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="grid_rows" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="items" type="jsonb"/>
            <column name="created_date" type="timestamp"/>
            <column name="created_by" type="varchar(150)"/>
            <column name="modified_date" type="timestamp"/>
            <column name="modified_by" type="varchar(150)"/>
        </createTable>
    </changeSet>

    <changeSet id="68-2" author="slawomir.wieczorek">
        <comment>Delete a user's PDF layouts together with the user</comment>
        <addForeignKeyConstraint
                baseTableName="pdf_layout"
                baseColumnNames="user_id"
                constraintName="fk_pdf_layout_user"
                referencedTableName="user_"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="68-3" author="slawomir.wieczorek">
        <comment>Index pdf_layout by owner and data domain, one name per user and dashboard</comment>
        <createIndex tableName="pdf_layout" indexName="idx_pdf_layout_user_id">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="pdf_layout" indexName="idx_pdf_layout_user_context">
            <column name="user_id"/>
            <column name="context_key"/>
        </createIndex>
        <addUniqueConstraint
                tableName="pdf_layout"
                columnNames="user_id, instance_name, dashboard_id, name"
                constraintName="uq_pdf_layout_user_dashboard_name"/>
    </changeSet>

</databaseChangeLog>
